// Тесты к модулю 06: контроль остатков при проведении РеализацияТоваров.
// Предполагаются объекты сквозного проекта (project/README.md):
//   Документ.ПоступлениеТоваров, Документ.РеализацияТоваров (ТЧ Товары: Номенклатура, Количество, Цена, Сумма),
//   РегистрНакопления.ОстаткиТоваров (Номенклатура, Склад; Количество).

#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Успешное проведение").ВТранзакции()
			.ДобавитьСерверныйТест("ПриДостаточномОстаткеДокументПроводится")
			.ДобавитьСерверныйТест("ПовторноеПроведениеНеДублируетДвижения")
		// Ошибка проведения внутри транзакции помечает всю транзакцию как ошибочную,
		// после чего запросы в ней невозможны. Поэтому этот тест — без транзакции,
		// а созданные им данные удаляет сам движок.
		.ДобавитьТестовыйНабор("Отказ в проведении").ВТранзакции(Ложь).УдалениеТестовыхДанных()
			.ДобавитьСерверныйТест("ПриНехваткеОстаткаДокументНеПроводится");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ПриДостаточномОстаткеДокументПроводится() Экспорт

	Контекст = НовыйКонтекст(10);

	Реализация = СоздатьРеализацию(Контекст, 3);
	Реализация.Записать(РежимЗаписиДокумента.Проведение);

	ЮТест.ОжидаетЧто(Реализация.Проведен, "Документ должен провестись").Равно(Истина);
	ЮТест.ОжидаетЧто(Остаток(Контекст), "Остаток после списания").Равно(7);

КонецПроцедуры

Процедура ПриНехваткеОстаткаДокументНеПроводится() Экспорт

	Контекст = НовыйКонтекст(10);
	Реализация = СоздатьРеализацию(Контекст, 20);

	Попытка
		Реализация.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		// Ожидаемо: при Отказ = Истина в ОбработкаПроведения программная запись вызывает исключение.
	КонецПопытки;

	ЮТест.ОжидаетЧто(ЧислоПроведенныхРеализаций(Контекст),
		"Документ не должен провестись при нехватке остатка").Равно(0);
	ЮТест.ОжидаетЧто(Остаток(Контекст), "Остаток не должен измениться").Равно(10);

КонецПроцедуры

Процедура ПовторноеПроведениеНеДублируетДвижения() Экспорт

	Контекст = НовыйКонтекст(10);
	Реализация = СоздатьРеализацию(Контекст, 4);
	Реализация.Записать(РежимЗаписиДокумента.Проведение);
	Реализация.Записать(РежимЗаписиДокумента.Проведение);

	ЮТест.ОжидаетЧто(Остаток(Контекст), "Перепроведение не должно списывать повторно").Равно(6);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт номенклатуру, склад и проведённое поступление на КоличествоПрихода штук.
Функция НовыйКонтекст(КоличествоПрихода)

	Контекст = Новый Структура;
	Контекст.Вставить("Номенклатура", ЮТест.Данные().КонструкторОбъекта("Справочник.Номенклатура")
		.ФикцияОбязательныхПолей()
		.Установить("ВидНоменклатуры", Перечисления.ВидыНоменклатуры.Товар)
		.Записать());
	Контекст.Вставить("Склад", ЮТест.Данные().КонструкторОбъекта("Справочник.Склады")
		.ФикцияОбязательныхПолей()
		.Записать());

	ЮТест.Данные().КонструкторОбъекта("Документ.ПоступлениеТоваров")
		.ФикцияОбязательныхПолей()
		.Установить("Дата", ТекущаяДатаСеанса() - 3600)
		.Установить("Склад", Контекст.Склад)
		.ТабличнаяЧасть("Товары")
			.ДобавитьСтроку()
			.Установить("Номенклатура", Контекст.Номенклатура)
			.Установить("Количество", КоличествоПрихода)
			.Установить("Цена", 100)
			.Установить("Сумма", 100 * КоличествоПрихода)
		.Провести();

	Возврат Контекст;

КонецФункции

Функция СоздатьРеализацию(Контекст, Количество)

	Возврат ЮТест.Данные().КонструкторОбъекта("Документ.РеализацияТоваров")
		.ФикцияОбязательныхПолей()
		.Установить("Дата", ТекущаяДатаСеанса())
		.Установить("Склад", Контекст.Склад)
		.ТабличнаяЧасть("Товары")
			.ДобавитьСтроку()
			.Установить("Номенклатура", Контекст.Номенклатура)
			.Установить("Количество", Количество)
			.Установить("Цена", 150)
			.Установить("Сумма", 150 * Количество)
		.НовыйОбъект();

КонецФункции

Функция Остаток(Контекст)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Номенклатура = &Номенклатура И Склад = &Склад) КАК Остатки");
	Запрос.УстановитьПараметр("Номенклатура", Контекст.Номенклатура);
	Запрос.УстановитьПараметр("Склад", Контекст.Склад);

	Возврат Запрос.Выполнить().Выгрузить()[0].Количество;

КонецФункции

Функция ЧислоПроведенныхРеализаций(Контекст)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Товары.Ссылка) КАК Число
	|ИЗ
	|	Документ.РеализацияТоваров.Товары КАК Товары
	|ГДЕ
	|	Товары.Номенклатура = &Номенклатура
	|	И Товары.Ссылка.Проведен");
	Запрос.УстановитьПараметр("Номенклатура", Контекст.Номенклатура);

	Возврат Запрос.Выполнить().Выгрузить()[0].Число;

КонецФункции

#КонецОбласти
